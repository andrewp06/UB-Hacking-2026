import math
import os
import pygame

pygame.init()

# Window setup
WIDTH, HEIGHT = 900, 700
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Character Creator - Outward Facing Joints")
clock = pygame.time.Clock()

# Load assets and scale cleanly for pixel art
script_dir = os.path.dirname(__file__)
img_path = os.path.join(script_dir, "test_leg.png")

try:
  raw_leg_img = pygame.image.load(img_path).convert_alpha()
  leg_img = pygame.transform.scale(raw_leg_img, (120, 120))
  leg_thumb = pygame.transform.scale(leg_img, (60, 60))
except FileNotFoundError:
  leg_img = pygame.Surface((120, 120))
  leg_img.fill((200, 100, 100))
  leg_thumb = pygame.transform.scale(leg_img, (60, 60))

# UI Sidebar dimensions
UI_WIDTH = 200

sidebar_items = [
    {"type": "leg", "rect": pygame.Rect(20, 30, 160, 70)},
    {"type": "circle_body", "rect": pygame.Rect(20, 120, 160, 70)},
    {"type": "rect_limb", "rect": pygame.Rect(20, 210, 160, 70)},
]

# List of placed parts:
# {'type': str, 'pos': [x, y], 'angle': int, 'parent': body_index or None, 'parent_joint': int, 'my_joint': int}
placed_parts = []

# Interaction state variables
dragging_type = None
dragging_index = None
drag_mode = None
drag_offset = [0, 0]
current_angle = 0
rotation_angle_offset = 0

# Define local connection points relative to part center (0,0)
BODY_LOCAL_POINTS = []
body_angles = [-120, -60, 180, 0, 120, 60]
for angle_deg in body_angles:
  rad = math.radians(angle_deg)
  bx = int(62 * math.cos(rad))
  by = int(62 * math.sin(rad))
  BODY_LOCAL_POINTS.append(pygame.math.Vector2(bx, by))

LIMB_LOCAL_POINTS = [
    pygame.math.Vector2(0, -50),  # Top joint (Index 0)
    pygame.math.Vector2(0, 50),  # Bottom joint (Index 1)
]

LEG_LOCAL_POINTS = [
    pygame.math.Vector2(0, -50),  # Top joint (Index 0)
    pygame.math.Vector2(0, 50),  # Bottom joint (Index 1)
]


def get_part_center_offset(ptype):
  if ptype == "circle_body":
    return pygame.math.Vector2(80, 80)
  elif ptype == "rect_limb":
    return pygame.math.Vector2(25, 60)
  elif ptype == "leg":
    return pygame.math.Vector2(60, 60)
  return pygame.math.Vector2(0, 0)


def get_local_points_list(ptype):
  if ptype == "circle_body":
    return BODY_LOCAL_POINTS
  elif ptype == "rect_limb":
    return LIMB_LOCAL_POINTS
  elif ptype == "leg":
    return LEG_LOCAL_POINTS
  return []


def get_world_points(part):
  ptype = part["type"]
  pos = pygame.math.Vector2(part["pos"])
  angle = part["angle"]

  cx, cy = get_part_center_offset(ptype)
  center_world = pos + pygame.math.Vector2(cx, cy)

  local_offsets = get_local_points_list(ptype)
  world_pts = []

  for offset in local_offsets:
    rotated_offset = offset.rotate(-angle)
    world_pts.append(center_world + rotated_offset)

  return world_pts


def get_straight_out_angle(body_part, parent_joint_idx, limb_part, my_joint_idx):
  """Calculates the datum angle where the limb points straight outward from the body center."""
  body_center = pygame.math.Vector2(body_part["pos"]) + get_part_center_offset(
      body_part["type"]
  )
  body_local_pts = get_local_points_list(body_part["type"])
  joint_local_pos = body_local_pts[parent_joint_idx]

  # Vector from body center pointing outward through the connection point
  radial_dir = joint_local_pos.rotate(-body_part["angle"])

  # Baseline direction of the limb pointing outward away from the pin
  if my_joint_idx == 0:
    base_dir = pygame.math.Vector2(
        0, 1
    )  # Flipped from (0, -1) to point outward
  else:
    base_dir = pygame.math.Vector2(
        0, -1
    )  # Flipped from (0, 1) to point outward

  straight_angle = math.degrees(
      math.atan2(-radial_dir.y, radial_dir.x)
      - math.atan2(-base_dir.y, base_dir.x)
  )
  return straight_angle % 360


def clamp_angle_to_range(angle, center_angle):
  """Clamps an angle within +/- 45 degrees of a center datum angle."""
  diff = (angle - center_angle + 180) % 360 - 180
  diff = max(-45, min(45, diff))
  return (center_angle + diff) % 360


def get_sub_tree(root_idx, parts):
  tree = [root_idx]
  for i, p in enumerate(parts):
    if p.get("parent") == root_idx and i not in tree:
      tree.extend(get_sub_tree(i, parts))
  return tree


running = True
while running:
  mouse_pos = pygame.math.Vector2(pygame.mouse.get_pos())
  keys = pygame.key.get_pressed()
  shift_held = keys[pygame.K_LSHIFT] or keys[pygame.K_RSHIFT]

  for event in pygame.event.get():
    if event.type == pygame.QUIT:
      running = False

    elif event.type == pygame.MOUSEBUTTONDOWN:
      if event.button == 1:  # Left click
        if mouse_pos.x < UI_WIDTH:
          for item in sidebar_items:
            if item["rect"].collidepoint(mouse_pos):
              dragging_type = item["type"]
              current_angle = 0
              c_off = get_part_center_offset(dragging_type)
              drag_offset = [-c_off.x, -c_off.y]
        else:
          for i in range(len(placed_parts) - 1, -1, -1):
            part = placed_parts[i]
            ptype = part["type"]
            px, py = part["pos"]
            w, h = (
                (160, 160)
                if ptype == "circle_body"
                else (50, 120)
                if ptype == "rect_limb"
                else (120, 120)
            )
            part_rect = pygame.Rect(px, py, w, h)

            if part_rect.collidepoint(mouse_pos):
              dragging_index = i

              if part["parent"] is not None and not shift_held:
                drag_mode = "rotate_attached"
                body_part = placed_parts[part["parent"]]
                body_pts = get_world_points(body_part)
                pin_world = body_pts[part["parent_joint"]]

                local_pts = get_local_points_list(part["type"])
                free_joint_idx = 1 if part["my_joint"] == 0 else 0
                unrotated_free_offset = local_pts[free_joint_idx]

                current_mouse_angle = math.degrees(
                    math.atan2(pin_world.y - mouse_pos.y, mouse_pos.x - pin_world.x)
                )
                base_free_angle = math.degrees(
                    math.atan2(
                        -unrotated_free_offset.y, unrotated_free_offset.x
                    )
                )
                rotation_angle_offset = (
                    part["angle"] - current_mouse_angle - base_free_angle
                )
              else:
                drag_mode = "move"
                target_idx = i
                if part["parent"] is not None and shift_held:
                  curr = i
                  while placed_parts[curr]["parent"] is not None:
                    curr = placed_parts[curr]["parent"]
                  target_idx = curr
                  dragging_index = target_idx

                r_px, r_py = placed_parts[dragging_index]["pos"]
                drag_offset = [r_px - mouse_pos.x, r_py - mouse_pos.y]
              break

    elif event.type == pygame.MOUSEBUTTONUP:
      if event.button == 1:
        if dragging_type:
          if mouse_pos.x >= UI_WIDTH:
            drop_x = mouse_pos.x + drag_offset[0]
            drop_y = mouse_pos.y + drag_offset[1]
            new_part = {
                "type": dragging_type,
                "pos": [drop_x, drop_y],
                "angle": current_angle,
                "parent": None,
                "parent_joint": None,
                "my_joint": None,
            }
            placed_parts.append(new_part)
          dragging_type = None

        elif dragging_index is not None:
          moved_part = placed_parts[dragging_index]
          if moved_part["type"] in ["rect_limb", "leg"]:
            if moved_part["parent"] is None:
              part_pts = get_world_points(moved_part)
              snapped = False
              for my_j_idx, lp_world in enumerate(part_pts):
                for b_idx, body_part in enumerate(placed_parts):
                  if b_idx == dragging_index:
                    continue
                  if body_part["type"] == "circle_body":
                    body_pts = get_world_points(body_part)
                    for bp_idx, bp_world in enumerate(body_pts):
                      dist = lp_world.distance_to(bp_world)
                      if dist < 25:
                        dx = bp_world.x - lp_world.x
                        dy = bp_world.y - lp_world.y

                        tree = get_sub_tree(dragging_index, placed_parts)
                        for idx in tree:
                          placed_parts[idx]["pos"][0] += dx
                          placed_parts[idx]["pos"][1] += dy

                        moved_part["parent"] = b_idx
                        moved_part["parent_joint"] = bp_idx
                        moved_part["my_joint"] = my_j_idx

                        # Auto-correct angle to be within +/- 45 deg of straight outward upon connection
                        straight_angle = get_straight_out_angle(
                            body_part, bp_idx, moved_part, my_j_idx
                        )
                        moved_part["angle"] = clamp_angle_to_range(
                            moved_part["angle"], straight_angle
                        )

                        # Re-anchor joint position after angle clamping
                        part_pts_new = get_world_points(moved_part)
                        current_joint_pt = part_pts_new[my_j_idx]
                        fix_dx = bp_world.x - current_joint_pt.x
                        fix_dy = bp_world.y - current_joint_pt.y
                        for idx in tree:
                          placed_parts[idx]["pos"][0] += fix_dx
                          placed_parts[idx]["pos"][1] += fix_dy

                        snapped = True
                        break
                    if snapped:
                      break
                if snapped:
                  break

          dragging_index = None
          drag_mode = None

    elif event.type == pygame.MOUSEWHEEL:
      if dragging_type:
        if dragging_type != "circle_body":
          current_angle = (current_angle + event.y * 15) % 360
      elif dragging_index is not None and drag_mode == "move":
        part = placed_parts[dragging_index]
        if part["type"] != "circle_body":
          old_angle = part["angle"]
          new_angle = (old_angle + event.y * 15) % 360

          if part["parent"] is not None:
            body_part = placed_parts[part["parent"]]
            straight_angle = get_straight_out_angle(
                body_part, part["parent_joint"], part, part["my_joint"]
            )
            new_angle = clamp_angle_to_range(new_angle, straight_angle)

          part["angle"] = new_angle

          if part["parent"] is not None:
            body_part = placed_parts[part["parent"]]
            body_pts = get_world_points(body_part)
            target_world_pt = body_pts[part["parent_joint"]]

            part_pts_new = get_world_points(part)
            current_joint_pt = part_pts_new[part["my_joint"]]
            dx = target_world_pt.x - current_joint_pt.x
            dy = target_world_pt.y - current_joint_pt.y
            part["pos"][0] += dx
            part["pos"][1] += dy
          else:
            old_pts = get_world_points(part)
            old_joint_world = old_pts[0]
            new_pts = get_world_points(part)
            new_joint_world = new_pts[0]
            part["pos"][0] += old_joint_world.x - new_joint_world.x
            part["pos"][1] += old_joint_world.y - new_joint_world.y

  # Mouse motion handling
  if dragging_index is not None:
    part = placed_parts[dragging_index]
    if drag_mode == "rotate_attached":
      body_part = placed_parts[part["parent"]]
      body_pts = get_world_points(body_part)
      pin_world = body_pts[part["parent_joint"]]

      current_mouse_angle = math.degrees(
          math.atan2(pin_world.y - mouse_pos.y, mouse_pos.x - pin_world.x)
      )
      local_pts = get_local_points_list(part["type"])
      free_joint_idx = 1 if part["my_joint"] == 0 else 0
      base_free_angle = math.degrees(
          math.atan2(-local_pts[free_joint_idx].y, local_pts[free_joint_idx].x)
      )

      raw_angle = (
          current_mouse_angle + base_free_angle + rotation_angle_offset
      ) % 360

      # Clamp rotation within +/- 45 degrees of straight outward datum
      straight_angle = get_straight_out_angle(
          body_part, part["parent_joint"], part, part["my_joint"]
      )
      part["angle"] = clamp_angle_to_range(raw_angle, straight_angle)

      # Re-anchor the pinned joint to stay glued to the body joint
      part_pts_new = get_world_points(part)
      current_joint_pt = part_pts_new[part["my_joint"]]
      dx = pin_world.x - current_joint_pt.x
      dy = pin_world.y - current_joint_pt.y
      part["pos"][0] += dx
      part["pos"][1] += dy

    elif drag_mode == "move":
      old_x, old_y = part["pos"]
      new_x = mouse_pos.x + drag_offset[0]
      new_y = mouse_pos.y + drag_offset[1]
      dx = new_x - old_x
      dy = new_y - old_y

      tree = get_sub_tree(dragging_index, placed_parts)
      for idx in tree:
        placed_parts[idx]["pos"][0] += dx
        placed_parts[idx]["pos"][1] += dy

      if shift_held and part["parent"] is not None:
        part["parent"] = None
        part["parent_joint"] = None
        part["my_joint"] = None

  # --- DRAWING / RENDERING ---
  screen.fill((240, 240, 240))
  pygame.draw.line(screen, (200, 200, 200), (UI_WIDTH, 0), (UI_WIDTH, HEIGHT), 3)


  def draw_part_surface(ptype, angle):
    c_off = get_part_center_offset(ptype)
    cx, cy = int(c_off.x), int(c_off.y)
    local_offsets = get_local_points_list(ptype)

    if ptype == "circle_body":
      surf = pygame.Surface((160, 160), pygame.SRCALPHA)
      pygame.draw.circle(surf, (0, 162, 232), (cx, cy), 80)
      for offset in local_offsets:
        dot_pos = pygame.math.Vector2(cx, cy) + offset
        pygame.draw.circle(surf, (0, 0, 0), (int(dot_pos.x), int(dot_pos.y)), 10)
      return pygame.transform.rotate(surf, angle)

    elif ptype == "rect_limb":
      surf = pygame.Surface((50, 120), pygame.SRCALPHA)
      pygame.draw.rect(surf, (34, 177, 76), (0, 0, 50, 120), border_radius=6)
      for offset in local_offsets:
        dot_pos = pygame.math.Vector2(cx, cy) + offset
        pygame.draw.circle(surf, (0, 0, 0), (int(dot_pos.x), int(dot_pos.y)), 10)
      return pygame.transform.rotate(surf, angle)

    elif ptype == "leg":
      surf = pygame.Surface((120, 120), pygame.SRCALPHA)
      surf.blit(leg_img, (0, 0))
      for offset in local_offsets:
        dot_pos = pygame.math.Vector2(cx, cy) + offset
        pygame.draw.circle(surf, (0, 0, 0), (int(dot_pos.x), int(dot_pos.y)), 10)
      return pygame.transform.rotate(surf, angle)


  def draw_part(surface, part):
    ptype = part["type"]
    x, y = part["pos"]
    angle = part["angle"]

    rot_img = draw_part_surface(ptype, angle)
    c_off = get_part_center_offset(ptype)
    rot_rect = rot_img.get_rect(center=(x + c_off.x, y + c_off.y))
    surface.blit(rot_img, rot_rect.topleft)


  # Draw all placed parts
  for part in placed_parts:
    draw_part(screen, part)

  # Draw UI Sidebar Background
  pygame.draw.rect(screen, (50, 50, 50), (0, 0, UI_WIDTH, HEIGHT))

  # Draw Sidebar Buttons & Labels
  font = pygame.font.SysFont(None, 22)
  for item in sidebar_items:
    pygame.draw.rect(screen, (80, 80, 80), item["rect"], border_radius=6)
    pygame.draw.rect(screen, (120, 120, 120), item["rect"], 2, border_radius=6)

    if item["type"] == "leg":
      text = font.render("Leg Part", True, (255, 255, 255))
      screen.blit(leg_thumb, (item["rect"].x + 10, item["rect"].centery - 30))
      screen.blit(text, (item["rect"].x + 75, item["rect"].centery - 10))
    elif item["type"] == "circle_body":
      text = font.render("Body (Head)", True, (255, 255, 255))
      screen.blit(text, (item["rect"].x + 15, item["rect"].centery - 10))
    elif item["type"] == "rect_limb":
      text = font.render("Rect Limb", True, (255, 255, 255))
      screen.blit(text, (item["rect"].x + 15, item["rect"].centery - 10))

  # Draw preview of NEW item being dragged from sidebar
  if dragging_type:
    preview_part = {
        "type": dragging_type,
        "pos": [
            mouse_pos.x + drag_offset[0],
            mouse_pos.y + drag_offset[1],
        ],
        "angle": current_angle,
    }
    draw_part(screen, preview_part)

  pygame.display.flip()
  clock.tick(60)

pygame.quit()